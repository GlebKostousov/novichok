# Для запуска создайте .env командой python3 scripts/configure.py.
# Скрипт создаст случайный пароль БД. Этот файл служит справкой по настройкам.
POSTGRES_PASSWORD=replace_with_random_hex_password
APP_PORT=8080
NOVICHOK_COOKIE_SECURE=false
NOVICHOK_ALLOWED_HOSTS=["localhost","127.0.0.1"]
NOVICHOK_MAX_WORKSPACES=500
